<?php

namespace App\Filament\Resources;

use App\Filament\Concerns\ChecksResourcePermission;
use App\Filament\Resources\ProductModelResource\Pages;
use App\Models\ProductLine;
use App\Models\ProductModel;
use Filament\Actions\BulkActionGroup;
use Filament\Actions\DeleteBulkAction;
use Filament\Actions\EditAction;
use Filament\Forms\Components\Select;
use Filament\Forms\Components\Textarea;
use Filament\Forms\Components\TextInput;
use Filament\Forms\Components\Toggle;
use Filament\Resources\Resource;
use Filament\Schemas\Schema;
use Filament\Tables;
use Filament\Tables\Table;
use Illuminate\Database\Eloquent\Builder;
use UnitEnum;
use App\Support\Fa;
use Filament\Tables\Columns\IconColumn;
use Filament\Tables\Filters\TernaryFilter;
use Filament\Tables\Filters\TrashedFilter;
use Filament\Actions\BulkAction;
use Filament\Actions\RestoreAction;
use Filament\Actions\ForceDeleteAction;
use Filament\Actions\RestoreBulkAction;
use Filament\Actions\ForceDeleteBulkAction;
use Filament\Schemas\Components\Section;
use App\Models\CatalogSeason;
use App\Models\CoverSku;
use App\Models\ProductFamily;
use App\Models\ProductOption;
use App\Models\ProductSize;
use Filament\Notifications\Notification;

class ProductModelResource extends Resource
{
public static function shouldRegisterNavigation(): bool
    {
        return true;
    }


    use ChecksResourcePermission;
protected static ?string $permissionView = 'products.view';
    protected static ?string $permissionManage = 'products.manage';
    protected static ?string $model = ProductModel::class;
    protected static string|\BackedEnum|null $navigationIcon = 'heroicon-o-cube-transparent';
    protected static ?string $modelLabel = 'مدل محصول';
    protected static ?string $pluralModelLabel = 'مدل‌های محصول';
    protected static ?string $navigationLabel = 'مدل‌ها';

    protected static string|\UnitEnum|null $navigationGroup = 'نوتوپیا';
    protected static ?int $navigationSort = 2;

    public static function getEloquentQuery(): Builder
    {
        $query = parent::getEloquentQuery();
        $notopiaId = ProductLine::query()->where('code', 'notopia')->value('id');
        if ($notopiaId) {
            $query->where('product_line_id', $notopiaId);
        }

        return $query;
    }

    public static function form(Schema $schema): Schema
    {
        return $schema->components([
            Section::make('هویت مدل')
                ->description('خانواده + کالکشن + نام تجاری. اقلام و رنگ از استخر انتخاب می‌شوند، نه با تیک ثابت.')
                ->columns(2)
                ->schema([
                    Select::make('product_line_id')
                        ->label('خط محصول')
                        ->relationship('productLine', 'name')
                        ->required()
                        ->default(fn () => \App\Models\ProductLine::query()->where('code', 'notopia')->value('id'))
                        ->dehydrated(),
                    Select::make('product_family_id')
                        ->label('خانواده')
                        ->options(fn () => ProductFamily::query()->where('is_active', true)->orderBy('sort')->pluck('name', 'id'))
                        ->searchable()
                        ->preload()
                        ->required()
                        ->helperText('مثلاً کیوان، مانا'),
                    Select::make('catalog_season_id')
                        ->label('کالکشن / سال')
                        ->options(fn () => CatalogSeason::query()->where('is_active', true)->orderBy('sort')->pluck('name', 'id'))
                        ->searchable()
                        ->preload()
                        ->required()
                        ->helperText('مثلاً کالکشن ۱۴۰۵'),
                    TextInput::make('code')
                        ->label('کد')
                        ->required()
                        ->maxLength(50)
                        ->unique(ignoreRecord: true)
                        ->helperText('پیشنهاد: KEYVAN-ZIBA-1405'),
                    TextInput::make('name')
                        ->label('نام مدل')
                        ->required()
                        ->maxLength(100)
                        ->helperText('مثلاً زیبا، نسیم')
                        ->columnSpanFull(),
                    Textarea::make('description')
                        ->label('توضیحات')
                        ->rows(2)
                        ->columnSpanFull(),
                    Textarea::make('internal_note')
                        ->label('یادداشت داخلی فروش')
                        ->rows(2)
                        ->columnSpanFull()
                        ->helperText('فقط برای تیم؛ روی فاکتور نیست.'),
                ]),

            Section::make('فروش و انتشار')
                ->columns(2)
                ->schema([
                    TextInput::make('base_price')
                        ->label('قیمت پایه (ریال)')
                        ->numeric()
                        ->minValue(0),
                    TextInput::make('sort')
                        ->label('ترتیب')
                        ->numeric()
                        ->default(0),
                    Select::make('status')
                        ->label('وضعیت انتشار')
                        ->options([
                            'draft' => 'پیش‌نویس',
                            'published' => 'منتشر (قابل سفارش)',
                            'archived' => 'بایگانی',
                        ])
                        ->required()
                        ->default('draft')
                        ->helperText('منتشر فقط با حداقل یک سایز و یک رنگ/جلد مجاز.'),
                    Toggle::make('is_active')
                        ->label('فعال در سیستم')
                        ->default(true)
                        ->inline(false),
                    Toggle::make('has_special_paper')
                        ->label('کاغذ داخلی مخصوص')
                        ->inline(false),
                    TextInput::make('cost_price')
                        ->label('بهای تمام‌شده (ریال) — اختیاری')
                        ->numeric()
                        ->minValue(0),
                ]),

            Section::make('ماتریس مجاز از استخر')
                ->description('فقط همین گزینه‌ها در سفارش دیده می‌شوند. بدون رنگ/سایز نمی‌توانید منتشر کنید.')
                ->schema([
                    Select::make('sizes')
                        ->label('سایزهای مجاز')
                        ->multiple()
                        ->relationship('sizes', 'name')
                        ->preload()
                        ->searchable()
                        ->helperText('حداقل یک مورد برای انتشار'),
                    Select::make('coverSkus')
                        ->label('رنگ / جلدهای مجاز (Cover SKU)')
                        ->multiple()
                        ->relationship('coverSkus', 'name')
                        ->preload()
                        ->searchable()
                        ->getOptionLabelFromRecordUsing(fn (CoverSku $r) => trim(($r->sku ? $r->sku.' — ' : '').($r->name ?? '')))
                        ->helperText('حداقل یک مورد برای انتشار'),
                    Select::make('options')
                        ->label('اقلام همراه مجاز')
                        ->multiple()
                        ->relationship('options', 'name')
                        ->preload()
                        ->searchable()
                        ->helperText('مثلاً خودکار فقط برای زیبا؛ برای نسیم خالی بگذارید'),
                ]),
        ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->recordUrl(null)
            ->recordAction(null)
            ->columns([
                Tables\Columns\TextColumn::make('name')
                    ->label('نام')
                    ->searchable()
                    ->sortable()
                    ->weight('medium')
                    ->description(fn ($record) => $record?->code)
                    ->url(fn ($record) => static::getUrl('edit', ['record' => $record]))
                    ->color('primary'),
                Tables\Columns\TextColumn::make('family.name')
                    ->label('خانواده')
                    ->sortable()
                    ->toggleable()
                    ->placeholder('—'),
                Tables\Columns\TextColumn::make('season.name')
                    ->label('کالکشن')
                    ->sortable()
                    ->toggleable()
                    ->placeholder('—'),
                Tables\Columns\TextColumn::make('status')
                    ->label('انتشار')
                    ->badge()
                    ->formatStateUsing(fn ($state) => match ($state) {
                        'published' => 'منتشر',
                        'archived' => 'بایگانی',
                        default => 'پیش‌نویس',
                    })
                    ->color(fn ($state) => match ($state) {
                        'published' => 'success',
                        'archived' => 'gray',
                        default => 'warning',
                    }),
                Tables\Columns\TextColumn::make('base_price')
                    ->label('قیمت پایه')
                    ->alignCenter()
                    ->formatStateUsing(fn ($state) => $state === null || $state === '' ? '—' : Fa::number($state, 0)),
                Tables\Columns\TextColumn::make('cover_skus_count')
                    ->counts('coverSkus')
                    ->label('رنگ/جلد')
                    ->alignCenter()
                    ->formatStateUsing(fn ($state) => Fa::digits((string) $state)),
                Tables\Columns\TextColumn::make('options_count')
                    ->counts('options')
                    ->label('اقلام')
                    ->alignCenter()
                    ->formatStateUsing(fn ($state) => Fa::digits((string) $state)),
                Tables\Columns\IconColumn::make('is_active')
                    ->label('وضعیت')
                    ->boolean()
                    ->trueIcon('heroicon-o-check-circle')
                    ->falseIcon('heroicon-o-no-symbol')
                    ->trueColor('success')
                    ->falseColor('gray')
                    ->action(
                        \Filament\Actions\Action::make('toggleActive')
                            ->requiresConfirmation()
                            ->modalHeading(fn ($record) => $record->is_active ? 'غیرفعال کردن مدل' : 'فعال کردن مدل')
                            ->modalDescription('یادآوری: پس از ماژول سفارش، وابستگی به سفارش باز بررسی می‌شود.')
                            ->modalSubmitActionLabel('تأیید')
                            ->action(fn ($record) => $record->update(['is_active' => ! $record->is_active]))
                    ),
                Tables\Columns\TextColumn::make('updated_at')
                    ->label('آخرین تغییر')
                    ->toggleable(isToggledHiddenByDefault: true)
                    ->formatStateUsing(fn ($state) => Fa::dateTime($state)),
            ])
            ->defaultSort('sort')
            ->filters([
                Tables\Filters\SelectFilter::make('product_family_id')
                    ->label('خانواده')
                    ->options(fn () => ProductFamily::query()->orderBy('sort')->pluck('name', 'id')),
                Tables\Filters\SelectFilter::make('catalog_season_id')
                    ->label('کالکشن')
                    ->options(fn () => CatalogSeason::query()->orderBy('sort')->pluck('name', 'id')),
                Tables\Filters\SelectFilter::make('status')
                    ->label('انتشار')
                    ->options([
                        'draft' => 'پیش‌نویس',
                        'published' => 'منتشر',
                        'archived' => 'بایگانی',
                    ]),
                Tables\Filters\TrashedFilter::make(),
            ])
            ->recordActions([
                \Filament\Actions\EditAction::make()->label('ویرایش'),
            ])
            ->emptyStateHeading('مدلی ثبت نشده')
            ->emptyStateDescription('ابتدا خانواده و کالکشن بسازید، بعد مدل (مثلاً زیبا ۱۴۰۵).')
            ->emptyStateActions([
                \Filament\Actions\CreateAction::make()->label('مدل جدید'),
            ])
            ->paginated([10, 15, 25, 50, 100]);
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListProductModels::route('/'),
            'create' => Pages\CreateProductModel::route('/create'),
            'edit' => Pages\EditProductModel::route('/{record}/edit'),
        ];
    }
}
