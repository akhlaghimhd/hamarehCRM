    public static function form(Schema $schema): Schema
    {
        return $schema->components([
            Section::make('هویت مدل')
                ->description('خانواده + کالکشن + نام. رنگ و اقلام از استخر.')
                ->columns(2)
                ->schema([
                    Select::make('product_line_id')
                        ->label('خط محصول')
                        ->relationship('productLine', 'name')
                        ->required()
                        ->default(fn () => \App\Models\ProductLine::query()->where('code', 'notopia')->value('id'))
                        ->dehydrated(),
                    Select::make('product_family_id')
                        ->label('خانواده')
                        ->options(fn () => ProductFamily::query()->where('is_active', true)->orderBy('sort')->pluck('name', 'id'))
                        ->searchable()->preload()->required(),
                    Select::make('catalog_season_id')
                        ->label('کالکشن / سال')
                        ->options(fn () => CatalogSeason::query()->where('is_active', true)->orderBy('sort')->pluck('name', 'id'))
                        ->searchable()->preload()->required(),
                    TextInput::make('code')
                        ->label('کد')->required()->maxLength(50)->unique(ignoreRecord: true)
                        ->helperText('مثال: KEYVAN-ZIBA-1405'),
                    TextInput::make('name')
                        ->label('نام مدل')->required()->maxLength(100)
                        ->helperText('مثال: زیبا، نسیم')->columnSpanFull(),
                    Textarea::make('description')->label('توضیحات')->rows(2)->columnSpanFull(),
                    Textarea::make('internal_note')->label('یادداشت داخلی')->rows(2)->columnSpanFull(),
                ]),
            Section::make('فروش و انتشار')
                ->columns(2)
                ->schema([
                    TextInput::make('base_price')->label('قیمت پایه (ریال)')->numeric()->minValue(0),
                    TextInput::make('cost_price')->label('بهای تمام‌شده (اختیاری)')->numeric()->minValue(0),
                    TextInput::make('sort')->label('ترتیب')->numeric()->default(0),
                    Select::make('status')
                        ->label('وضعیت انتشار')
                        ->options([
                            'draft' => 'پیش‌نویس',
                            'published' => 'منتشر (قابل سفارش)',
                            'archived' => 'بایگانی',
                        ])
                        ->required()->default('draft')
                        ->helperText('منتشر فقط با حداقل یک سایز و یک رنگ/جلد'),
                    Toggle::make('is_active')->label('فعال')->default(true)->inline(false),
                    Toggle::make('has_special_paper')->label('کاغذ مخصوص')->inline(false),
                ]),
            Section::make('ماتریس مجاز از استخر')
                ->description('فقط این موارد در سفارش دیده می‌شوند.')
                ->schema([
                    Select::make('sizes')
                        ->label('سایزهای مجاز')
                        ->multiple()->relationship('sizes', 'name')
                        ->preload()->searchable(),
                    Select::make('coverSkus')
                        ->label('رنگ / جلد مجاز')
                        ->multiple()->relationship('coverSkus', 'name')
                        ->preload()->searchable(),
                    Select::make('options')
                        ->label('اقلام همراه مجاز')
                        ->multiple()->relationship('options', 'name')
                        ->preload()->searchable()
                        ->helperText('بدون خودکار = خالی بگذارید'),
                ]),
        ]);
    }

    public static function table(Table $table): Table
    {
        return $table
            ->recordUrl(null)
            ->recordAction(null)
            ->columns([
                Tables\Columns\TextColumn::make('name')
                    ->label('نام')->searchable()->sortable()->weight('medium')
                    ->description(fn ($record) => $record?->code)
                    ->url(fn ($record) => static::getUrl('edit', ['record' => $record]))
                    ->color('primary'),
                Tables\Columns\TextColumn::make('family.name')->label('خانواده')->sortable()->placeholder('—'),
                Tables\Columns\TextColumn::make('season.name')->label('کالکشن')->sortable()->placeholder('—'),
                Tables\Columns\TextColumn::make('status')
                    ->label('انتشار')->badge()
                    ->formatStateUsing(fn ($state) => match ($state) {
                        'published' => 'منتشر',
                        'archived' => 'بایگانی',
                        default => 'پیش‌نویس',
                    })
                    ->color(fn ($state) => match ($state) {
                        'published' => 'success',
                        'archived' => 'gray',
                        default => 'warning',
                    }),
                Tables\Columns\TextColumn::make('base_price')
                    ->label('قیمت پایه')->alignCenter()
                    ->formatStateUsing(fn ($state) => $state === null || $state === '' ? '—' : Fa::number($state, 0)),
                Tables\Columns\TextColumn::make('cover_skus_count')
                    ->counts('coverSkus')->label('رنگ/جلد')->alignCenter()
                    ->formatStateUsing(fn ($state) => Fa::digits((string) ($state ?? 0))),
                Tables\Columns\TextColumn::make('options_count')
                    ->counts('options')->label('اقلام')->alignCenter()
                    ->formatStateUsing(fn ($state) => Fa::digits((string) ($state ?? 0))),
                Tables\Columns\IconColumn::make('is_active')
                    ->label('وضعیت')->boolean()
                    ->trueIcon('heroicon-o-check-circle')
                    ->falseIcon('heroicon-o-no-symbol')
                    ->trueColor('success')->falseColor('gray'),
            ])
            ->defaultSort('sort')
            ->filters([
                Tables\Filters\SelectFilter::make('product_family_id')
                    ->label('خانواده')
                    ->options(fn () => ProductFamily::query()->orderBy('sort')->pluck('name', 'id')),
                Tables\Filters\SelectFilter::make('catalog_season_id')
                    ->label('کالکشن')
                    ->options(fn () => CatalogSeason::query()->orderBy('sort')->pluck('name', 'id')),
                Tables\Filters\SelectFilter::make('status')
                    ->label('انتشار')
                    ->options(['draft' => 'پیش‌نویس', 'published' => 'منتشر', 'archived' => 'بایگانی']),
                Tables\Filters\TrashedFilter::make(),
            ])
            ->recordActions([

                \Filament\Actions\Action::make('duplicate')
                    ->label('کپی')
                    ->icon('heroicon-o-document-duplicate')
                    ->form([
                        \Filament\Forms\Components\Select::make('catalog_season_id')
                            ->label('کالکشن مقصد')
                            ->options(fn () => \App\Models\CatalogSeason::query()->where('is_active', true)->orderBy('sort')->pluck('name', 'id'))
                            ->required(),
                        \Filament\Forms\Components\TextInput::make('code')
                            ->label('کد جدید')
                            ->required(),
                        \Filament\Forms\Components\TextInput::make('name')
                            ->label('نام جدید')
                            ->required(),
                    ])
                    ->fillForm(fn ($record) => [
                        'catalog_season_id' => $record->catalog_season_id,
                        'code' => $record->code . '-COPY',
                        'name' => $record->name . ' (کپی)',
                    ])
                    ->action(function ($record, array $data) {
                        $copy = $record->duplicateForCatalog(
                            seasonId: (int) $data['catalog_season_id'],
                            code: $data['code'],
                            name: $data['name'],
                        );
                        \Filament\Notifications\Notification::make()
                            ->title('مدل کپی شد')
                            ->success()
                            ->send();
                        return redirect(static::getUrl('edit', ['record' => $copy]));
                    }),

                \Filament\Actions\EditAction::make()->label('ویرایش'),
            ])
            ->emptyStateHeading('مدلی ثبت نشده')
            ->emptyStateDescription('اول خانواده و کالکشن، بعد مدل.')
            ->emptyStateActions([
                \Filament\Actions\CreateAction::make()->label('مدل جدید'),
            ])
            ->paginated([10, 15, 25, 50, 100]);
    }

    public static function getPages(): array
    {
        return [
            'index' => Pages\ListProductModels::route('/'),
            'create' => Pages\CreateProductModel::route('/create'),
            'edit' => Pages\EditProductModel::route('/{record}/edit'),
        ];
    }
}
