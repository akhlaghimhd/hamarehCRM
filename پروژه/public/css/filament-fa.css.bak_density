@font-face {
  font-family: 'Vazirmatn';
  src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/fonts/webfonts/Vazirmatn-Regular.woff2') format('woff2');
  font-weight: 400;
  font-display: swap;
}
@font-face {
  font-family: 'Vazirmatn';
  src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/fonts/webfonts/Vazirmatn-Medium.woff2') format('woff2');
  font-weight: 500;
  font-display: swap;
}
@font-face {
  font-family: 'Vazirmatn';
  src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/fonts/webfonts/Vazirmatn-Bold.woff2') format('woff2');
  font-weight: 700;
  font-display: swap;
}

body, .fi-body, .fi-main, .fi-sidebar, .fi-topbar, .fi-modal, .fi-btn,
input, select, textarea, button, label {
  font-family: 'Vazirmatn', Tahoma, ui-sans-serif, system-ui, sans-serif !important;
}

/* سایدبار */
.fi-sidebar.fi-sidebar-open {
  width: 15rem !important;
  max-width: 15rem !important;
}
.fi-sidebar:not(.fi-sidebar-open) {
  width: 4.5rem !important;
  max-width: 4.5rem !important;
  min-width: 4.5rem !important;
}
.fi-sidebar:not(.fi-sidebar-open) .fi-sidebar-item-label,
.fi-sidebar:not(.fi-sidebar-open) .fi-sidebar-group-label {
  display: none !important;
}
.fi-sidebar:not(.fi-sidebar-open) .fi-sidebar-item-button {
  justify-content: center !important;
}

/* فشرده‌سازی متن سلول جدول (نام + توضیح) */
.fi-ta-text,
.fi-ta-text-has-description,
.fi-ta-text.fi-ta-text-has-description,
div.fi-ta-text.fi-ta-text-has-description {
  padding: 0 5px !important;
  margin: 0 !important;
  gap: 0 !important;
  line-height: 1.2 !important;
  min-height: 0 !important;
}
.fi-ta-text-item,
.fi-ta-text-description {
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1.15 !important;
}
.fi-ta-text-description {
  font-size: 0.75rem !important;
  opacity: 0.65;
}

/* چگالی فشرده‌تر فرم‌ها */
.fi-sc-has-gap {
  gap: 0.5rem !important;
}
.fi-section-content-ctn {
  padding-top: 0.5rem !important;
  padding-bottom: 0.5rem !important;
}
.fi-fo-field-wrp {
  gap: 0.2rem !important;
}
.fi-section-header {
  padding-top: 0.5rem !important;
  padding-bottom: 0.25rem !important;
}
.fi-ta-ctn, .fi-section {
  --spacing: 0.5rem;
}
