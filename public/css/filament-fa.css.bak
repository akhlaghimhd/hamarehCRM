@font-face {
  font-family: 'Vazirmatn';
  src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/fonts/webfonts/Vazirmatn-Regular.woff2') format('woff2');
  font-weight: 400;
  font-display: swap;
}
@font-face {
  font-family: 'Vazirmatn';
  src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/fonts/webfonts/Vazirmatn-Medium.woff2') format('woff2');
  font-weight: 500;
  font-display: swap;
}
@font-face {
  font-family: 'Vazirmatn';
  src: url('https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/fonts/webfonts/Vazirmatn-Bold.woff2') format('woff2');
  font-weight: 700;
  font-display: swap;
}

body, .fi-body, .fi-main, .fi-sidebar, .fi-topbar, .fi-modal, .fi-btn,
input, select, textarea, button, label {
  font-family: 'Vazirmatn', Tahoma, ui-sans-serif, system-ui, sans-serif !important;
}

/* سایدبار */
.fi-sidebar.fi-sidebar-open {
  width: 15rem !important;
  max-width: 15rem !important;
}
.fi-sidebar:not(.fi-sidebar-open) {
  width: 4.5rem !important;
  max-width: 4.5rem !important;
  min-width: 4.5rem !important;
}
.fi-sidebar:not(.fi-sidebar-open) .fi-sidebar-item-label,
.fi-sidebar:not(.fi-sidebar-open) .fi-sidebar-group-label {
  display: none !important;
}
.fi-sidebar:not(.fi-sidebar-open) .fi-sidebar-item-button {
  justify-content: center !important;
}

/* فشرده‌سازی متن سلول جدول (نام + توضیح) */
.fi-ta-text,
.fi-ta-text-has-description,
.fi-ta-text.fi-ta-text-has-description,
div.fi-ta-text.fi-ta-text-has-description {
  padding: 0 5px !important;
  margin: 0 !important;
  gap: 0 !important;
  line-height: 1.2 !important;
  min-height: 0 !important;
}
.fi-ta-text-item,
.fi-ta-text-description {
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1.15 !important;
}
.fi-ta-text-description {
  font-size: 0.75rem !important;
  opacity: 0.65;
}

/* چگالی فشرده‌تر فرم‌ها */
.fi-sc-has-gap {
  gap: 0.5rem !important;
}
.fi-section-content-ctn {
  padding-top: 0.5rem !important;
  padding-bottom: 0.5rem !important;
}
.fi-fo-field-wrp {
  gap: 0.2rem !important;
}
.fi-section-header {
  padding-top: 0.5rem !important;
  padding-bottom: 0.25rem !important;
}
.fi-ta-ctn, .fi-section {
  --spacing: 0.5rem;
}


/* === myoffice density (global admin) === */

/* هدر صفحه */
.fi-page-header-main-ctn,
.fi-page-header-main {
  flex-grow: 0 !important;
  min-height: 0 !important;
  gap: 0.25rem !important;
  padding-top: 0.25rem !important;
  padding-bottom: 0.25rem !important;
}
.fi-header-heading {
  font-size: 1.15rem !important;
  line-height: 1.25 !important;
  margin: 0 !important;
}
.fi-breadcrumbs {
  margin: 0 !important;
  font-size: 0.8rem !important;
}

/* —— جدول —— */
.fi-ta-header-cell {
  padding: 0.4rem 0.6rem !important;
  line-height: 1.25 !important;
}
.fi-ta-cell {
  padding: 0.35rem 0.6rem !important;
  line-height: 1.25 !important;
  vertical-align: middle !important;
}
.fi-ta-text {
  line-height: 1.25 !important;
}
.fi-ta-text-description {
  font-size: 0.75rem !important;
  line-height: 1.2 !important;
  margin-top: 0.05rem !important;
}

/* سورت ستون — دیده شود */
.fi-ta-header-cell button,
.fi-ta-header-cell .fi-ta-header-cell-sort-icon,
.fi-ta-header-cell svg {
  opacity: 0.85 !important;
  width: 0.9rem !important;
  height: 0.9rem !important;
}

/* نوار جستجو / فیلتر */
.fi-ta-header-toolbar {
  padding: 0.5rem 0.75rem !important;
  gap: 0.5rem !important;
}
.fi-ta-search-field input.fi-input,
.fi-ta-search-field .fi-input {
  min-height: 2rem !important;
  height: 2rem !important;
  padding-top: 0.25rem !important;
  padding-bottom: 0.25rem !important;
}
.fi-ta-header-toolbar .fi-icon-btn {
  width: 2rem !important;
  height: 2rem !important;
  min-height: 2rem !important;
  padding: 0.3rem !important;
}
.fi-ta-header-toolbar .fi-icon-btn svg {
  width: 1.1rem !important;
  height: 1.1rem !important;
}

/* آیکن وضعیت داخل سلول */
.fi-ta-cell .fi-icon-btn svg,
.fi-ta-cell svg {
  width: 1.15rem !important;
  height: 1.15rem !important;
}

/* اکشن ردیف */
.fi-ta-actions {
  gap: 0.25rem !important;
}
.fi-ta-actions .fi-btn,
.fi-ta-actions .fi-link {
  font-size: 0.8rem !important;
  padding-top: 0.2rem !important;
  padding-bottom: 0.2rem !important;
}

/* —— فرم: فقط فاصله، بدون height اجباری روی اینپوت —— */
.fi-section-content,
.fi-section-content-ctn {
  padding: 0.6rem 0.85rem !important;
}
.fi-section-header {
  padding: 0.4rem 0.85rem !important;
}
.fi-sc-has-gap {
  gap: 0.5rem 0.75rem !important;
}
.fi-fo-field-wrp {
  gap: 0.15rem !important;
}
.fi-fo-field-wrp-label {
  margin: 0 !important;
  line-height: 1.25 !important;
}
.fi-fo-field-wrp-hint {
  margin-top: 0.1rem !important;
  font-size: 0.75rem !important;
  line-height: 1.25 !important;
}
.fi-tabs {
  margin-bottom: 0.35rem !important;
}
.fi-tabs-item {
  padding: 0.35rem 0.65rem !important;
}

/* === end density === */

